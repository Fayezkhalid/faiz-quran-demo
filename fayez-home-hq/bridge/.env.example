# انسخ هذا الملف باسم .env وعبّه. لا ترفع .env على GitHub.

# الصفحة تفتح على http://localhost:8787
PORT=8787
# 127.0.0.1 = الكمبيوتر بس. 0.0.0.0 = تقدر تفتحها من جوالك على نفس شبكة البيت
HOST=127.0.0.1

# Bambu Lab A2L Combo (من شاشة الطابعة: Settings > Network / LAN)
PRINTER_IP=192.168.1.50
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=
PRINTER_MODEL=A2L Combo

# WhatsApp عن طريق CallMeBot (مجاني، يرسل لرقمك أنت)
# رقمك بالصيغة الدولية بدون + مثل 9665XXXXXXXX
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# ميزانية البيت الشهرية بالريال
MONTHLY_BUDGET=9000

# المرشد الأكاديمي: وقت تذكير الماجستير اليومي على الواتساب (بتوقيت الكمبيوتر)
MASTERS_REMINDER_TIME=20:00

# Telegram (بديل الواتساب، مجاني ورسمي): التوكن من @BotFather. الـ Chat ID ينحفظ لحاله لما ترسل /start للبوت
TELEGRAM_BOT_TOKEN=

# Gmail (قراءة فقط): كلمة مرور تطبيقات من https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
